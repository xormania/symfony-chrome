{
  "schema": 1,
  "profiles": {
    "required": [
      "fast",
      "package",
      "support",
      "environment",
      "browser",
      "tooling"
    ]
  },
  "suites": {
    "fast": {
      "script": "tools/testing/fast.py",
      "checks": [
        "fast.contracts"
      ],
      "timeout": 120
    },
    "package": {
      "script": "tools/testing/package.py",
      "checks": [
        "package.archives",
        "package.kernel",
        "consumer.prod",
        "consumer.dev"
      ],
      "timeout": 900
    },
    "environment": {
      "script": "tools/testing/environment.py",
      "checks": [
        "environment.identity",
        "environment.fixture",
        "environment.platform",
        "environment.mago"
      ],
      "timeout": 1200
    },
    "support": {
      "script": "tools/testing/support.py",
      "checks": [
        "support.checker-source",
        "support.current-policy-and-actual-parent"
      ],
      "timeout": 900
    },
    "browser": {
      "script": "tools/testing/browser.py",
      "checks": [
        "browser.chrome-mcp",
        "browser.borrowed-endpoint",
        "browser.request-profile",
        "browser.guards"
      ],
      "timeout": 1200
    },
    "tooling": {
      "script": "tools/testing/tooling.py",
      "checks": [
        "tooling.mate",
        "tooling.native-mago",
        "tooling.enriched-mago",
        "tooling.serena-mago",
        "tooling.external-spans"
      ],
      "timeout": 1800
    }
  }
}

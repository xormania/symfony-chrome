{
    "name": "xormania/symfony-chrome-consumer",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "8.1.*",
        "symfony/yaml": "8.1.*",
        "xormania/chrome-bundle": "^0.1@dev",
        "symfony/console": "8.1.*"
    },
    "require-dev": {
        "xormania/chrome-devtools-bundle": "^0.1@dev"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "xormania/chrome-bundle",
                "description": "Chrome browser APIs, CDP, and MCP capabilities for Symfony applications. Runtime bundle.",
                "type": "symfony-bundle",
                "license": "MIT",
                "keywords": [
                    "symfony-ux",
                    "chrome",
                    "mcp",
                    "webmcp",
                    "devtools"
                ],
                "require": {
                    "php": ">=8.4",
                    "symfony/config": "^7.3|^8.0",
                    "symfony/dependency-injection": "^7.3|^8.0",
                    "symfony/framework-bundle": "^7.3|^8.0",
                    "symfony/http-kernel": "^7.3|^8.0"
                },
                "suggest": {
                    "chrome-php/chrome": "Managed Chrome operations from PHP (CDP adapter)",
                    "symfony/mcp-bundle": "Expose package operations as MCP tools and resources",
                    "symfony/messenger": "Asynchronous managed-browser jobs"
                },
                "autoload": {
                    "psr-4": {
                        "Xormania\\ChromeBundle\\": "src/"
                    }
                },
                "minimum-stability": "dev",
                "prefer-stable": true,
                "version": "0.1.x-dev",
                "dist": {
                    "type": "zip",
                    "url": "../../packages/chrome-bundle.zip",
                    "reference": "ci"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "xormania/chrome-devtools-bundle",
                "description": "Development-only diagnostics for xormania/chrome-bundle: Profiler correlation, Chrome DevTools MCP integration, component observations.",
                "type": "symfony-bundle",
                "license": "MIT",
                "require": {
                    "php": ">=8.4",
                    "symfony/framework-bundle": "^7.3|^8.0",
                    "symfony/http-kernel": "^7.3|^8.0",
                    "xormania/chrome-bundle": "^0.1@dev"
                },
                "suggest": {
                    "symfony/web-profiler-bundle": "Exact request-to-profile correlation by X-Debug-Token",
                    "symfony/ai-mate": "Reuse Mate collectors and formatters where the installed version allows"
                },
                "autoload": {
                    "psr-4": {
                        "Xormania\\ChromeDevtoolsBundle\\": "src/"
                    }
                },
                "minimum-stability": "dev",
                "prefer-stable": true,
                "version": "0.1.x-dev",
                "dist": {
                    "type": "zip",
                    "url": "../../packages/chrome-devtools-bundle.zip",
                    "reference": "ci"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.26"
        }
    }
}

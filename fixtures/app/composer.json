{
    "name": "xormania/symfony-chrome-fixture",
    "description": "Minimal Symfony 8.1 consumer of the Symfony-Chrome packages. No UXor dependency.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "ext-ctype": "*",
        "ext-iconv": "*",
        "php": ">=8.4",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/monolog-bundle": "^4",
        "symfony/runtime": "8.1.*",
        "symfony/stimulus-bundle": "^2.12",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-live-component": "^3.6",
        "symfony/ux-twig-component": "^3.6",
        "symfony/yaml": "8.1.*",
        "xormania/chrome-bundle": "^0.1@dev"
    },
    "require-dev": {
        "byte-kitsune/mago-symfony-wiring": "dev-poc-28c3f54",
        "carthage-software/mago": "1.58.2",
        "phpunit/phpunit": "^12.0",
        "symfony/ai-mate": "0.15.0",
        "symfony/ai-monolog-mate-extension": "0.15.0",
        "symfony/ai-symfony-mate-extension": "0.15.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.36",
        "symfony/stopwatch": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "xormania/chrome-devtools-bundle": "^0.1@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/chrome-bundle",
            "options": {
                "symlink": true,
                "versions": {
                    "xormania/chrome-bundle": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/chrome-devtools-bundle",
            "options": {
                "symlink": true,
                "versions": {
                    "xormania/chrome-devtools-bundle": "0.1.x-dev"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "carthage-software/mago",
                "version": "1.58.2",
                "type": "library",
                "license": [
                    "MIT",
                    "Apache-2.0"
                ],
                "require": {
                    "php": "~8.1 || ~8.2 || ~8.3 || ~8.4 || ~8.5 || ~8.6",
                    "revolt/event-loop": "^1.0.9"
                },
                "autoload": {
                    "psr-4": {
                        "Mago\\": "composer/src/"
                    },
                    "files": [
                        "composer/src/functions.php",
                        "composer/src/internal.php"
                    ]
                },
                "source": {
                    "type": "git",
                    "url": "https://github.com/carthage-software/mago.git",
                    "reference": "46df50c96d93d0ac3655c116c375574277cf0b30"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/carthage-software/mago/zipball/46df50c96d93d0ac3655c116c375574277cf0b30",
                    "reference": "46df50c96d93d0ac3655c116c375574277cf0b30"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "byte-kitsune/mago-symfony-wiring",
                "version": "dev-poc-28c3f54",
                "type": "library",
                "license": "MIT",
                "require": {
                    "php": "^8.2",
                    "carthage-software/mago": "^1.50",
                    "nikic/php-parser": "^5.9",
                    "symfony/yaml": "^7.4 || ^8.0"
                },
                "autoload": {
                    "psr-4": {
                        "ByteKitsune\\MagoSymfonyWiring\\": "src/"
                    }
                },
                "source": {
                    "type": "git",
                    "url": "https://github.com/Byte-Kitsune/mago-symfony-wiring.git",
                    "reference": "28c3f54065b71fe046a7474ced401aeadc941b0f"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/Byte-Kitsune/mago-symfony-wiring/zipball/28c3f54065b71fe046a7474ced401aeadc941b0f",
                    "reference": "28c3f54065b71fe046a7474ced401aeadc941b0f"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/ai-mate-composer-plugin": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.4.26"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Mate\\": "mate/src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*"
        },
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    }
}

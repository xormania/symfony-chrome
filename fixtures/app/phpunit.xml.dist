<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" failOnEmptyTestSuite="true" failOnRisky="true" failOnWarning="true">
    <php><env name="APP_ENV" value="test" force="true"/><env name="APP_DEBUG" value="0" force="true"/></php>
    <testsuites><testsuite name="Packages"><directory>../../packages/tests</directory></testsuite></testsuites>
</phpunit>
